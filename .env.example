# Development-only values for the local Docker database.
# If you change the password, update DATABASE_URL and TEST_DATABASE_URL as well.
POSTGRES_PASSWORD=shortly_local_dev
DATABASE_URL=postgresql://shortly:shortly_local_dev@127.0.0.1:5432/shortly
TEST_DATABASE_URL=postgresql://shortly:shortly_local_dev@127.0.0.1:5432/shortly_test
RATE_LIMIT_SECRET=shortly-local-development-only
